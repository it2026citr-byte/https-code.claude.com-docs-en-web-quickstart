		<query>////////////////////////////////////////////////////////////////////////////////
// Отчёт &quot;Гант по заказам на производство&quot; (план/факт производства)
// Конфигурация: 1С:ERP Управление предприятием 2.5
//
// Структура строк (по образцу &quot;ПРИМЕР.xlsx&quot;):
//   Документ-основание (заказ клиента / давальца)
//     └ Заказ на производство      — интервал &quot;План&quot;
//         └ Этап производства      — интервал &quot;Факт&quot;
//
//   ПЛАН — от &quot;Начать не ранее&quot; заказа на производство,
//          длительностью &quot;Срок изготовления, к дней&quot;
//          (доп. реквизит документа-основания, календарные дни).
//          Ориентир окончания — &quot;Желаемая дата выпуска&quot; заказа на производство.
//   ФАКТ — по каждому этапу производства отдельной строкой:
//          фактическое начало/окончание этапа, а если факт ещё не проставлен —
//          плановые даты этапа.
//
// Параметры:
//   &amp;СвойствоСрокИзготовления — ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения
//                               (доп. реквизит &quot;Срок изготовления, к дней&quot;)
//   &amp;НачалоПериода, &amp;КонецПериода — отбор по &quot;Начать не ранее&quot;; пустая дата = без ограничения
//   &amp;Статусы — список статусов ЗНП (по умолчанию: Формируется, КПроизводству)
//
// ТОЧКИ АДАПТАЦИИ помечены [ПРОВЕРИТЬ] — см. docs/01-Анализ-ТЗ.md
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// 1. Заказы на производство и их документы-основания
//    [ПРОВЕРИТЬ] Документ.ЗаказНаПроизводство2_5:
//       НачатьНеРанее        — &quot;Начать не ранее&quot;
//       ЖелаемаяДатаВыпуска  — &quot;Желаемая дата выпуска&quot;
//    [ПРОВЕРИТЬ] ТЧ Продукция: реквизит Заказ (заказ клиента / заказ давальца)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЗНП.Ссылка КАК Заказ,
	ЗНП.Номер КАК Номер,
	ЗНП.Дата КАК ДатаДокумента,
	ЗНП.Статус КАК Статус,
	ЗНП.Подразделение КАК Подразделение,
	ЗНП.НачатьНеРанее КАК НачатьНеРанее,
	ЗНП.ЖелаемаяДатаВыпуска КАК ЖелаемаяДатаВыпуска,
	Продукция.Заказ КАК ДокументОснование
ПОМЕСТИТЬ ВТ_Заказы
ИЗ
	Документ.ЗаказНаПроизводство2_5 КАК ЗНП
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_5.Продукция КАК Продукция
		ПО Продукция.Ссылка = ЗНП.Ссылка
ГДЕ
	НЕ ЗНП.ПометкаУдаления
	И ЗНП.Статус В (&amp;Статусы)
	И (&amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1) ИЛИ ЗНП.НачатьНеРанее &gt;= &amp;НачалоПериода)
	И (&amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1) ИЛИ ЗНП.НачатьНеРанее &lt;= &amp;КонецПериода)

ИНДЕКСИРОВАТЬ ПО
	Заказ,
	ДокументОснование
;

////////////////////////////////////////////////////////////////////////////////
// 2. &quot;Срок изготовления, к дней&quot; из документа-основания.
//    Ищем и в табличной части ДополнительныеРеквизиты заказа клиента / давальца,
//    и в регистре ДополнительныеСведения — какой бы способ хранения ни был настроен.
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	З.Заказ КАК Заказ,
	З.ДокументОснование КАК ДокументОснование,
	ВЫРАЗИТЬ(ДопРеквКлиента.Значение КАК ЧИСЛО(10, 2)) КАК СрокИзготовленияДней
ПОМЕСТИТЬ ВТ_СрокВсеИсточники
ИЗ
	ВТ_Заказы КАК З
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ДополнительныеРеквизиты КАК ДопРеквКлиента
		ПО ДопРеквКлиента.Ссылка = З.ДокументОснование
			И ДопРеквКлиента.Свойство = &amp;СвойствоСрокИзготовления

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	З.Заказ,
	З.ДокументОснование,
	ВЫРАЗИТЬ(ДопРеквДавальца.Значение КАК ЧИСЛО(10, 2))
ИЗ
	ВТ_Заказы КАК З
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца.ДополнительныеРеквизиты КАК ДопРеквДавальца
		ПО ДопРеквДавальца.Ссылка = З.ДокументОснование
			И ДопРеквДавальца.Свойство = &amp;СвойствоСрокИзготовления

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	З.Заказ,
	З.ДокументОснование,
	ВЫРАЗИТЬ(ДопСведения.Значение КАК ЧИСЛО(10, 2))
ИЗ
	ВТ_Заказы КАК З
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения
		ПО ДопСведения.Объект = З.ДокументОснование
			И ДопСведения.Свойство = &amp;СвойствоСрокИзготовления
;

ВЫБРАТЬ
	СВ.Заказ КАК Заказ,
	СВ.ДокументОснование КАК ДокументОснование,
	МАКСИМУМ(СВ.СрокИзготовленияДней) КАК СрокИзготовленияДней
ПОМЕСТИТЬ ВТ_Срок
ИЗ
	ВТ_СрокВсеИсточники КАК СВ
ГДЕ
	СВ.СрокИзготовленияДней ЕСТЬ НЕ NULL

СГРУППИРОВАТЬ ПО
	СВ.Заказ,
	СВ.ДокументОснование

ИНДЕКСИРОВАТЬ ПО
	Заказ,
	ДокументОснование
;

////////////////////////////////////////////////////////////////////////////////
// 3. Этапы производства заказов — по строке на этап.
//    [ПРОВЕРИТЬ] Документ.ЭтапПроизводства2_5:
//       ЗаказНаПроизводство                      — ссылка на ЗНП
//       ДатаНачала / ДатаЗавершения              — план по графику
//       ДатаНачалаФакт / ДатаЗавершенияФакт      — факт (&quot;Начат&quot; / &quot;Завершен&quot;)
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Этапы.Ссылка КАК Этап,
	Этапы.Номер КАК НомерЭтапа,
	Этапы.ЗаказНаПроизводство КАК Заказ,
	Этапы.ДатаНачалаФакт КАК НачатФакт,
	Этапы.ДатаЗавершенияФакт КАК ЗавершенФакт,
	ВЫБОР
		КОГДА Этапы.ДатаНачалаФакт = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА Этапы.ДатаНачала
		ИНАЧЕ Этапы.ДатаНачалаФакт
	КОНЕЦ КАК ДатаНачалаИнтервала,
	ВЫБОР
		КОГДА Этапы.ДатаЗавершенияФакт = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА Этапы.ДатаЗавершения
		ИНАЧЕ Этапы.ДатаЗавершенияФакт
	КОНЕЦ КАК ДатаОкончанияИнтервала
ПОМЕСТИТЬ ВТ_Этапы
ИЗ
	Документ.ЭтапПроизводства2_5 КАК Этапы
ГДЕ
	НЕ Этапы.ПометкаУдаления
	И Этапы.ЗаказНаПроизводство В
			(ВЫБРАТЬ
				З.Заказ
			ИЗ
				ВТ_Заказы КАК З)

ИНДЕКСИРОВАТЬ ПО
	Заказ
;

////////////////////////////////////////////////////////////////////////////////
// 4. Результат.
//    Строка &quot;План&quot; — на уровне заказа на производство,
//    строки &quot;Факт&quot; — на уровне каждого этапа производства.
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	З.ДокументОснование КАК ДокументОснование,
	З.Заказ КАК Заказ,
	З.Номер КАК Номер,
	З.ДатаДокумента КАК ДатаДокумента,
	З.Статус КАК Статус,
	З.Подразделение КАК Подразделение,
	ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_5.ПустаяСсылка) КАК Этап,
	ВЫРАЗИТЬ(&quot;План&quot; КАК СТРОКА(10)) КАК ВидИнтервала,
	1 КАК ПорядокВида,
	З.НачатьНеРанее КАК ДатаНачала,
	ВЫБОР
		КОГДА ЕСТЬNULL(С.СрокИзготовленияДней, 0) &gt; 0
			ТОГДА ДОБАВИТЬКДАТЕ(З.НачатьНеРанее, ДЕНЬ, ВЫРАЗИТЬ(С.СрокИзготовленияДней КАК ЧИСЛО(10, 0)))
		КОГДА З.ЖелаемаяДатаВыпуска &gt; З.НачатьНеРанее
			ТОГДА З.ЖелаемаяДатаВыпуска
		ИНАЧЕ ДОБАВИТЬКДАТЕ(З.НачатьНеРанее, ДЕНЬ, 1)
	КОНЕЦ КАК ДатаОкончания,
	З.НачатьНеРанее КАК НачатьНеРанее,
	З.ЖелаемаяДатаВыпуска КАК ЖелаемаяДатаВыпуска,
	ЕСТЬNULL(С.СрокИзготовленияДней, 0) КАК СрокИзготовленияДней,
	ДАТАВРЕМЯ(1, 1, 1) КАК НачатФакт,
	ДАТАВРЕМЯ(1, 1, 1) КАК ЗавершенФакт,
	ЛОЖЬ КАК ЭтоФакт
ИЗ
	ВТ_Заказы КАК З
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Срок КАК С
		ПО С.Заказ = З.Заказ
			И С.ДокументОснование = З.ДокументОснование
ГДЕ
	З.НачатьНеРанее &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	З.ДокументОснование,
	З.Заказ,
	З.Номер,
	З.ДатаДокумента,
	З.Статус,
	З.Подразделение,
	Э.Этап,
	ВЫРАЗИТЬ(&quot;Факт&quot; КАК СТРОКА(10)),
	2,
	Э.ДатаНачалаИнтервала,
	ВЫБОР
		КОГДА Э.ДатаОкончанияИнтервала &gt; Э.ДатаНачалаИнтервала
			ТОГДА Э.ДатаОкончанияИнтервала
		ИНАЧЕ ДОБАВИТЬКДАТЕ(Э.ДатаНачалаИнтервала, ДЕНЬ, 1)
	КОНЕЦ,
	З.НачатьНеРанее,
	З.ЖелаемаяДатаВыпуска,
	ЕСТЬNULL(С.СрокИзготовленияДней, 0),
	Э.НачатФакт,
	Э.ЗавершенФакт,
	ИСТИНА
ИЗ
	ВТ_Заказы КАК З
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Этапы КАК Э
		ПО Э.Заказ = З.Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Срок КАК С
		ПО С.Заказ = З.Заказ
			И С.ДокументОснование = З.ДокументОснование
ГДЕ
	Э.ДатаНачалаИнтервала &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)

УПОРЯДОЧИТЬ ПО
	Статус,
	ДокументОснование,
	ДатаНачала,
	Номер,
	ПорядокВида
</query>
	</dataSet>
	<calculatedField>
		<dataPath>ДлительностьДней</dataPath>
		<expression>РазностьДат(ДатаНачала, ДатаОкончания, &quot;ДЕНЬ&quot;)</expression>
		<title xsi:type="v8:LocalStringType"><v8:item><v8:lang>ru</v8:lang><v8:content>Длительность, дней</v8:content></v8:item></title>
	</calculatedField>
	<totalField>
		<dataPath>ДатаНачала</dataPath>
		<expression>Минимум(ДатаНачала)</expression>
	</totalField>
	<totalField>
		<dataPath>ДатаОкончания</dataPath>
		<expression>Максимум(ДатаОкончания)</expression>
	</totalField>
	<totalField>
		<dataPath>НачатьНеРанее</dataPath>
		<expression>Минимум(НачатьНеРанее)</expression>
	</totalField>
	<totalField>
		<dataPath>ЖелаемаяДатаВыпуска</dataPath>
		<expression>Максимум(ЖелаемаяДатаВыпуска)</expression>
	</totalField>
	<totalField>
		<dataPath>СрокИзготовленияДней</dataPath>
		<expression>Максимум(СрокИзготовленияДней)</expression>
	</totalField>
	<totalField>
		<dataPath>НачатФакт</dataPath>
		<expression>Минимум(НачатФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗавершенФакт</dataPath>
		<expression>Максимум(ЗавершенФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>ДлительностьДней</dataPath>
		<expression>Максимум(ДлительностьДней)</expression>
	</totalField>
