// ObjectLinksMap.bsl
// -----------------------------------------------------------------------------
// Построение карты связей между объектами метаданных.
//
// Назначение: получить граф «кто на кого ссылается», из которого выводятся
//   - негативные проверки (обязательный реквизит не заполнен);
//   - проверки составных типов (каждый тип надо покрыть отдельно);
//   - сквозные E2E-сценарии (цепочки документ -> документ);
//   - проверки движений (документ -> регистры).
//
// Результат: CSV-файл вида
//   Источник;Путь;Реквизит;Приемник;Обязательный;ТипСоставной
//   Документ.ЗаказКлиента;Шапка;Партнер;Справочник.Партнеры;Да;Нет
//   Документ.ЗаказКлиента;ТЧ.Товары;Номенклатура;Справочник.Номенклатура;Да;Нет
//   Документ.ЗаказКлиента;Движения;-;РегистрНакопления.ЗаказыКлиентов;-;-
//
// Запуск: аналогично DbStatistics.bsl (внешняя обработка / консоль кода).
// Метаданные читаются без обращения к данным — работает быстро.
// -----------------------------------------------------------------------------

&НаСервере
Функция ПостроитьКартуСвязей(ПутьКФайлу = "C:\dump\object_links.csv") Экспорт

	Результат = Новый ТекстовыйДокумент;
	Результат.ДобавитьСтроку("Источник;Путь;Реквизит;Приемник;Обязательный;ТипСоставной");

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.БизнесПроцессы);
	Коллекции.Добавить(Метаданные.Задачи);

	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого ОбъектМД Из Коллекция Цикл

			ПолноеИмя = ОбъектМД.ПолноеИмя();

			// --- Реквизиты шапки ---
			Попытка
				ДобавитьСвязиРеквизитов(Результат, ПолноеИмя, "Шапка", ОбъектМД.Реквизиты);
			Исключение
			КонецПопытки;

			// --- Измерения и ресурсы регистров ---
			Попытка
				ДобавитьСвязиРеквизитов(Результат, ПолноеИмя, "Измерение", ОбъектМД.Измерения);
			Исключение
			КонецПопытки;
			Попытка
				ДобавитьСвязиРеквизитов(Результат, ПолноеИмя, "Ресурс", ОбъектМД.Ресурсы);
			Исключение
			КонецПопытки;

			// --- Табличные части ---
			Попытка
				Для Каждого ТабЧасть Из ОбъектМД.ТабличныеЧасти Цикл
					ДобавитьСвязиРеквизитов(Результат, ПолноеИмя,
						"ТЧ." + ТабЧасть.Имя, ТабЧасть.Реквизиты);
				КонецЦикла;
			Исключение
			КонецПопытки;

			// --- Стандартные реквизиты справочников: владелец, родитель ---
			Если Метаданные.Справочники.Содержит(ОбъектМД) Тогда
				Для Каждого Владелец Из ОбъектМД.Владельцы Цикл
					Результат.ДобавитьСтроку(СтрШаблон("%1;Стандартный;Владелец;%2;Да;%3",
						ПолноеИмя,
						Владелец.ПолноеИмя(),
						?(ОбъектМД.Владельцы.Количество() > 1, "Да", "Нет")));
				КонецЦикла;
				Если ОбъектМД.Иерархический Тогда
					Результат.ДобавитьСтроку(СтрШаблон("%1;Стандартный;Родитель;%1;Нет;Нет", ПолноеИмя));
				КонецЕсли;
			КонецЕсли;

			// --- Движения документов по регистрам ---
			Если Метаданные.Документы.Содержит(ОбъектМД) Тогда
				Для Каждого Регистр Из ОбъектМД.Движения Цикл
					Результат.ДобавитьСтроку(СтрШаблон("%1;Движения;-;%2;-;-",
						ПолноеИмя, Регистр.ПолноеИмя()));
				КонецЦикла;
				// Документы-основания (ввод на основании)
				Для Каждого Основание Из ОбъектМД.ВводимыеНаОсновании Цикл
					Результат.ДобавитьСтроку(СтрШаблон("%1;ВводНаОсновании;-;%2;-;-",
						ПолноеИмя, Основание.ПолноеИмя()));
				КонецЦикла;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Результат.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Возврат ПутьКФайлу;

КонецФункции

// -----------------------------------------------------------------------------

&НаСервере
Процедура ДобавитьСвязиРеквизитов(Результат, ИмяИсточника, Путь, КоллекцияРеквизитов)

	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл

		Типы = Реквизит.Тип.Типы();
		ТипСоставной = ?(Типы.Количество() > 1, "Да", "Нет");

		// Обязательность определяется проверкой заполнения.
		// У измерений/ресурсов регистров свойства может не быть — тогда "Нет".
		Обязательный = "Нет";
		Попытка
			Если Реквизит.ПроверкаЗаполнения
				= Метаданные.СвойстваОбъектов.ПроверкаЗаполнения.ВыдаватьОшибку Тогда
				Обязательный = "Да";
			КонецЕсли;
		Исключение
		КонецПопытки;

		Для Каждого Тип Из Типы Цикл
			МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
			Если МетаданныеТипа = Неопределено Тогда
				Продолжить; // примитивный тип — это не связь
			КонецЕсли;

			Результат.ДобавитьСтроку(СтрШаблон("%1;%2;%3;%4;%5;%6",
				ИмяИсточника,
				Путь,
				Реквизит.Имя,
				МетаданныеТипа.ПолноеИмя(),
				Обязательный,
				ТипСоставной));
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры
