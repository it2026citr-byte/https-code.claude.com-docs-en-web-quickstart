// DbStatistics.bsl
// -----------------------------------------------------------------------------
// Сбор статистики заполненности объектов метаданных базы erp_copy2.
//
// Назначение: понять, какие объекты конфигурации реально используются, чтобы
// отсечь из чек-листа тестирования неиспользуемые подсистемы.
//
// Результат: CSV-файл вида
//   Вид;ПолноеИмя;Синоним;Количество;Помечено
//   Документ;Документ.ЗаказКлиента;Заказ клиента;51203;418
//
// Количество = -1 означает, что таблицу не удалось опросить (нет прав либо
// объект не поддерживает запрос) — такие строки надо разобрать отдельно.
//
// Как запускать:
//   вариант А — вставить в модуль внешней обработки с формой и кнопкой;
//   вариант Б — выполнить в «Консоли кода» (ИТС) в серверном контексте;
//   вариант В — через Сервис -> Дополнительные обработки.
//
// Требования: полные права, иначе часть таблиц вернёт -1.
// Время выполнения на ERP: ориентировочно 3–15 минут.
// -----------------------------------------------------------------------------

&НаСервере
Функция СобратьСтатистику(ПутьКФайлу = "C:\dump\db_statistics.csv") Экспорт

	Результат = Новый ТекстовыйДокумент;
	Результат.ДобавитьСтроку("Вид;ПолноеИмя;Синоним;Количество;Помечено");

	// Виды объектов, у которых есть реквизит ПометкаУдаления
	СсылочныеВиды = Новый Массив;
	СсылочныеВиды.Добавить("Справочник");
	СсылочныеВиды.Добавить("Документ");
	СсылочныеВиды.Добавить("ПланВидовХарактеристик");
	СсылочныеВиды.Добавить("ПланСчетов");
	СсылочныеВиды.Добавить("БизнесПроцесс");
	СсылочныеВиды.Добавить("Задача");

	Коллекции = Новый Соответствие;
	Коллекции.Вставить("Справочник",             Метаданные.Справочники);
	Коллекции.Вставить("Документ",               Метаданные.Документы);
	Коллекции.Вставить("РегистрСведений",        Метаданные.РегистрыСведений);
	Коллекции.Вставить("РегистрНакопления",      Метаданные.РегистрыНакопления);
	Коллекции.Вставить("РегистрБухгалтерии",     Метаданные.РегистрыБухгалтерии);
	Коллекции.Вставить("РегистрРасчета",         Метаданные.РегистрыРасчета);
	Коллекции.Вставить("ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
	Коллекции.Вставить("ПланСчетов",             Метаданные.ПланыСчетов);
	Коллекции.Вставить("БизнесПроцесс",          Метаданные.БизнесПроцессы);
	Коллекции.Вставить("Задача",                 Метаданные.Задачи);

	Для Каждого ЭлементКоллекции Из Коллекции Цикл

		ВидОбъекта   = ЭлементКоллекции.Ключ;
		ЭтоСсылочный = (СсылочныеВиды.Найти(ВидОбъекта) <> Неопределено);

		Для Каждого ОбъектМД Из ЭлементКоллекции.Значение Цикл

			ПолноеИмя            = ОбъектМД.ПолноеИмя();
			Количество           = -1;
			КоличествоПомеченных = "";

			Попытка
				Запрос = Новый Запрос;
				Если ЭтоСсылочный Тогда
					Запрос.Текст =
						"ВЫБРАТЬ
						|	КОЛИЧЕСТВО(*) КАК Всего,
						|	СУММА(ВЫБОР КОГДА Т.ПометкаУдаления ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Помечено
						|ИЗ
						|	" + ПолноеИмя + " КАК Т";
				Иначе
					Запрос.Текст =
						"ВЫБРАТЬ
						|	КОЛИЧЕСТВО(*) КАК Всего,
						|	0 КАК Помечено
						|ИЗ
						|	" + ПолноеИмя + " КАК Т";
				КонецЕсли;

				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Количество = Выборка.Всего;
					Если ЭтоСсылочный Тогда
						КоличествоПомеченных = Формат(?(Выборка.Помечено = Null, 0, Выборка.Помечено), "ЧГ=0");
					КонецЕсли;
				КонецЕсли;
			Исключение
				Количество = -1;
			КонецПопытки;

			Результат.ДобавитьСтроку(СтрШаблон("%1;%2;%3;%4;%5",
				ВидОбъекта,
				ПолноеИмя,
				СтрЗаменить(ОбъектМД.Синоним, ";", ","),
				Формат(Количество, "ЧГ=0"),
				КоличествоПомеченных));

		КонецЦикла;
	КонецЦикла;

	Результат.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Возврат ПутьКФайлу;

КонецФункции

// -----------------------------------------------------------------------------
// Дополнительно: активность документов за период.
// Показывает, какие документы реально создаются СЕЙЧАС, а не были заведены
// когда-то давно. Используется для приоритизации проверок в чек-листе.
//
// Результат: CSV — ПолноеИмя;Синоним;КоличествоЗаПериод
// -----------------------------------------------------------------------------

&НаСервере
Функция АктивностьДокументов(НачалоПериода, КонецПериода,
	ПутьКФайлу = "C:\dump\doc_activity.csv") Экспорт

	Результат = Новый ТекстовыйДокумент;
	Результат.ДобавитьСтроку("ПолноеИмя;Синоним;КоличествоЗаПериод;КоличествоПроведенных");

	Для Каждого ОбъектМД Из Метаданные.Документы Цикл

		ПолноеИмя = ОбъектМД.ПолноеИмя();
		Всего = -1;
		Проведено = -1;

		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	КОЛИЧЕСТВО(*) КАК Всего,
				|	СУММА(ВЫБОР КОГДА Т.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведено
				|ИЗ
				|	" + ПолноеИмя + " КАК Т
				|ГДЕ
				|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
			Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Всего = Выборка.Всего;
				Проведено = ?(Выборка.Проведено = Null, 0, Выборка.Проведено);
			КонецЕсли;
		Исключение
			Всего = -1;
		КонецПопытки;

		// В отчёт попадают только используемые документы
		Если Всего > 0 Тогда
			Результат.ДобавитьСтроку(СтрШаблон("%1;%2;%3;%4",
				ПолноеИмя,
				СтрЗаменить(ОбъектМД.Синоним, ";", ","),
				Формат(Всего, "ЧГ=0"),
				Формат(Проведено, "ЧГ=0")));
		КонецЕсли;

	КонецЦикла;

	Результат.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Возврат ПутьКФайлу;

КонецФункции

// -----------------------------------------------------------------------------
// Включённые функциональные опции — определяют, какие блоки ERP активны.
// Без этого списка чек-лист невозможно корректно сузить.
// -----------------------------------------------------------------------------

&НаСервере
Функция ЗначенияФункциональныхОпций(ПутьКФайлу = "C:\dump\func_options.csv") Экспорт

	Результат = Новый ТекстовыйДокумент;
	Результат.ДобавитьСтроку("Имя;Синоним;Значение");

	Для Каждого ОпцияМД Из Метаданные.ФункциональныеОпции Цикл
		Значение = "";
		Попытка
			Значение = Строка(ПолучитьФункциональнуюОпцию(ОпцияМД.Имя));
		Исключение
			Значение = "<опция с параметрами, требует отбора>";
		КонецПопытки;

		Результат.ДобавитьСтроку(СтрШаблон("%1;%2;%3",
			ОпцияМД.Имя,
			СтрЗаменить(ОпцияМД.Синоним, ";", ","),
			Значение));
	КонецЦикла;

	Результат.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Возврат ПутьКФайлу;

КонецФункции
