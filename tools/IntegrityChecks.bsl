// IntegrityChecks.bsl
// -----------------------------------------------------------------------------
// Проверки целостности данных базы erp_copy2.
//
// Закрывает проверки ЦЕЛ-02..ЦЕЛ-06 из docs/02-test-checklist.md.
// Поиск битых ссылок сюда НЕ входит — он полнее и быстрее делается штатным
// «Тестированием и исправлением» в конфигураторе (ключ /IBCheckAndRepair)
// либо обработкой ИТС «Поиск ссылок на объект».
//
// Результат: CSV — Проверка;Объект;Детали;Количество
//
// Запуск: внешняя обработка / консоль кода, полные права.
// Часть проверок тяжёлые — запускать на копии в нерабочее время.
// -----------------------------------------------------------------------------

&НаСервере
Функция ВыполнитьВсеПроверки(ПутьКФайлу = "C:\dump\integrity_report.csv") Экспорт

	Результат = Новый ТекстовыйДокумент;
	Результат.ДобавитьСтроку("Проверка;Объект;Детали;Количество");

	ПроверитьЦиклыВИерархиях(Результат);
	ПроверитьДублиКонтрагентов(Результат);
	ПроверитьНезаполненныеРеквизиты(Результат);
	ПроверитьДвиженияНепроведенных(Результат);

	Результат.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Возврат ПутьКФайлу;

КонецФункции

// ЦЕЛ-04. Зацикленные иерархии.
// Элемент, который через цепочку родителей ссылается сам на себя, ломает любой
// обход дерева и подвешивает отчёты.
&НаСервере
Процедура ПроверитьЦиклыВИерархиях(Результат)

	Для Каждого ОбъектМД Из Метаданные.Справочники Цикл

		Если НЕ ОбъектМД.Иерархический Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмя = ОбъектМД.ПолноеИмя();

		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Т.Ссылка КАК Ссылка,
				|	Т.Родитель КАК Родитель
				|ИЗ
				|	" + ПолноеИмя + " КАК Т";
			Таблица = Запрос.Выполнить().Выгрузить();
		Исключение
			Продолжить;
		КонецПопытки;

		Родители = Новый Соответствие;
		Для Каждого Стр Из Таблица Цикл
			Родители.Вставить(Стр.Ссылка, Стр.Родитель);
		КонецЦикла;

		НайденоЦиклов = 0;
		НайденоГлубоких = 0;

		Для Каждого Стр Из Таблица Цикл
			Текущий = Стр.Родитель;
			Глубина = 0;
			Пока ЗначениеЗаполнено(Текущий) Цикл
				Если Текущий = Стр.Ссылка Тогда
					НайденоЦиклов = НайденоЦиклов + 1;
					Результат.ДобавитьСтроку(СтрШаблон("Цикл в иерархии;%1;%2;1",
						ПолноеИмя, СтрЗаменить(Строка(Стр.Ссылка), ";", ",")));
					Прервать;
				КонецЕсли;
				Глубина = Глубина + 1;
				Если Глубина > 100 Тогда
					НайденоГлубоких = НайденоГлубоких + 1;
					Результат.ДобавитьСтроку(СтрШаблон("Аномальная глубина иерархии (>100);%1;%2;1",
						ПолноеИмя, СтрЗаменить(Строка(Стр.Ссылка), ";", ",")));
					Прервать;
				КонецЕсли;
				Текущий = Родители.Получить(Текущий);
				Если Текущий = Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// ЦЕЛ-02. Дубли контрагентов по ИНН + КПП.
// Дубли контрагентов — источник расхождений во взаиморасчётах и в книгах НДС.
&НаСервере
Процедура ПроверитьДублиКонтрагентов(Результат)

	Если Метаданные.Справочники.Найти("Контрагенты") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	К.ИНН КАК ИНН,
			|	К.КПП КАК КПП,
			|	КОЛИЧЕСТВО(*) КАК Кол
			|ИЗ
			|	Справочник.Контрагенты КАК К
			|ГДЕ
			|	НЕ К.ПометкаУдаления
			|	И К.ИНН <> """"
			|СГРУППИРОВАТЬ ПО
			|	К.ИНН, К.КПП
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(*) > 1
			|УПОРЯДОЧИТЬ ПО
			|	Кол УБЫВ";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.ДобавитьСтроку(СтрШаблон("Дубль контрагента по ИНН+КПП;Справочник.Контрагенты;ИНН %1 КПП %2;%3",
				Выборка.ИНН, Выборка.КПП, Формат(Выборка.Кол, "ЧГ=0")));
		КонецЦикла;
	Исключение
		Результат.ДобавитьСтроку("Дубль контрагента по ИНН+КПП;Справочник.Контрагенты;проверка не выполнена (нет реквизита ИНН/КПП или прав);-1");
	КонецПопытки;

КонецПроцедуры

// ЦЕЛ-05. Незаполненные обязательные ссылочные реквизиты в проведённых документах.
// Проверяются только реквизиты с одним типом: для составных типов пустое
// значение неоднозначно, они разбираются отдельно.
&НаСервере
Процедура ПроверитьНезаполненныеРеквизиты(Результат)

	Для Каждого ОбъектМД Из Метаданные.Документы Цикл

		ПолноеИмя = ОбъектМД.ПолноеИмя();

		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл

			Обязательный = Ложь;
			Попытка
				Обязательный = (Реквизит.ПроверкаЗаполнения
					= Метаданные.СвойстваОбъектов.ПроверкаЗаполнения.ВыдаватьОшибку);
			Исключение
			КонецПопытки;

			Если НЕ Обязательный Тогда
				Продолжить;
			КонецЕсли;

			Типы = Реквизит.Тип.Типы();
			Если Типы.Количество() <> 1 Тогда
				Продолжить; // составной тип — пропускаем
			КонецЕсли;

			ПустоеЗначение = Реквизит.Тип.ПривестиЗначение();
			Если ПустоеЗначение = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ
					|	КОЛИЧЕСТВО(*) КАК Кол
					|ИЗ
					|	" + ПолноеИмя + " КАК Т
					|ГДЕ
					|	Т.Проведен
					|	И Т." + Реквизит.Имя + " = &ПустоеЗначение";
				Запрос.УстановитьПараметр("ПустоеЗначение", ПустоеЗначение);

				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() И Выборка.Кол > 0 Тогда
					Результат.ДобавитьСтроку(СтрШаблон("Пустой обязательный реквизит в проведённом документе;%1;%2;%3",
						ПолноеИмя, Реквизит.Имя, Формат(Выборка.Кол, "ЧГ=0")));
				КонецЕсли;
			Исключение
				// реквизит недоступен в запросе — пропускаем
			КонецПопытки;

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// ЦЕЛ-06. Движения, оставшиеся от непроведённых документов.
// Классический след аварийного завершения или ошибки в обработке проведения:
// документ не проведён, а записи в регистре остались и искажают остатки.
&НаСервере
Процедура ПроверитьДвиженияНепроведенных(Результат)

	Для Каждого ОбъектМД Из Метаданные.Документы Цикл

		ПолноеИмя = ОбъектМД.ПолноеИмя();

		Для Каждого Регистр Из ОбъектМД.Движения Цикл

			ИмяРегистра = Регистр.ПолноеИмя();

			Попытка
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.Регистратор) КАК Кол
					|ИЗ
					|	" + ИмяРегистра + " КАК Р
					|ГДЕ
					|	ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(" + ПолноеИмя + ")
					|	И НЕ ВЫРАЗИТЬ(Р.Регистратор КАК " + ПолноеИмя + ").Проведен";

				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() И Выборка.Кол > 0 Тогда
					Результат.ДобавитьСтроку(СтрШаблон("Движения непроведённого документа;%1;%2;%3",
						ПолноеИмя, ИмяРегистра, Формат(Выборка.Кол, "ЧГ=0")));
				КонецЕсли;
			Исключение
				// регистр не подчинён регистратору либо недоступен
			КонецПопытки;

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры
