// Диагностика метаданных erp_copy2 для отчёта "Гант по заказам на производство".
//
// Как запустить: консоль кода / консоль запросов с выполнением кода,
// либо вставить в модуль внешней обработки и вызвать.
// Результат откроется текстовым документом — его достаточно прислать,
// чтобы точно настроить запрос отчёта.

Текст = Новый ТекстовыйДокумент;

Текст.ДобавитьСтроку("Версия конфигурации: "
	+ Метаданные.Версия + " / " + Метаданные.Имя);
Текст.ДобавитьСтроку("");

ИменаДокументов = Новый Массив;
ИменаДокументов.Добавить("ЗаказНаПроизводство2_5");
ИменаДокументов.Добавить("ЭтапПроизводства2_5");
ИменаДокументов.Добавить("ЗаказКлиента");
ИменаДокументов.Добавить("ЗаказДавальца");

Для Каждого ИмяДокумента Из ИменаДокументов Цикл

	ОписаниеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если ОписаниеДокумента = Неопределено Тогда
		Текст.ДобавитьСтроку("!!! НЕ НАЙДЕН документ: " + ИмяДокумента);
		Текст.ДобавитьСтроку("");
		Продолжить;
	КонецЕсли;

	Текст.ДобавитьСтроку("=== Документ." + ОписаниеДокумента.Имя + " ===");
	Текст.ДобавитьСтроку("-- реквизиты шапки:");
	Для Каждого Реквизит Из ОписаниеДокумента.Реквизиты Цикл
		Текст.ДобавитьСтроку("   " + Реквизит.Имя + " : " + Строка(Реквизит.Тип));
	КонецЦикла;

	Текст.ДобавитьСтроку("-- табличные части:");
	Для Каждого ТабличнаяЧасть Из ОписаниеДокумента.ТабличныеЧасти Цикл
		Текст.ДобавитьСтроку("   [" + ТабличнаяЧасть.Имя + "]");
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Текст.ДобавитьСтроку("      " + Реквизит.Имя + " : " + Строка(Реквизит.Тип));
		КонецЦикла;
	КонецЦикла;
	Текст.ДобавитьСтроку("");

КонецЦикла;

// Статусы заказов на производство
ОписаниеПеречисления = Метаданные.Перечисления.Найти("СтатусыЗаказовНаПроизводство2_5");
Если ОписаниеПеречисления = Неопределено Тогда
	Текст.ДобавитьСтроку("!!! НЕ НАЙДЕНО перечисление СтатусыЗаказовНаПроизводство2_5");
Иначе
	Текст.ДобавитьСтроку("=== Перечисление." + ОписаниеПеречисления.Имя + " ===");
	Для Каждого ЗначениеПеречисления Из ОписаниеПеречисления.ЗначенияПеречисления Цикл
		Текст.ДобавитьСтроку("   " + ЗначениеПеречисления.Имя
			+ " (" + ЗначениеПеречисления.Синоним + ")");
	КонецЦикла;
КонецЕсли;
Текст.ДобавитьСтроку("");

// Доп. реквизиты / сведения, похожие на "Количество дней"
Запрос = Новый Запрос;
Запрос.Текст =
	"ВЫБРАТЬ
	|	Свойства.Ссылка КАК Ссылка,
	|	Свойства.Наименование КАК Наименование,
	|	Свойства.ТипЗначения КАК ТипЗначения,
	|	Свойства.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение,
	|	Свойства.НаборСвойств КАК НаборСвойств
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
	|ГДЕ
	|	НЕ Свойства.ПометкаУдаления
	|	И Свойства.Наименование ПОДОБНО &Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
Запрос.УстановитьПараметр("Наименование", "%дн%");

Текст.ДобавитьСтроку("=== Доп. реквизиты/сведения со словом 'дн' в наименовании ===");
Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
	Текст.ДобавитьСтроку("   " + Выборка.Наименование
		+ " | тип: " + Строка(Выборка.ТипЗначения)
		+ " | доп.сведение: " + Строка(Выборка.ЭтоДополнительноеСведение)
		+ " | набор: " + Строка(Выборка.НаборСвойств));
КонецЦикла;
Текст.ДобавитьСтроку("");

// Пример связи заказа на производство с документом-основанием
ЗапросСвязи = Новый Запрос;
ЗапросСвязи.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Продукция.Ссылка КАК ЗаказНаПроизводство,
	|	Продукция.Ссылка.Статус КАК Статус,
	|	Продукция.Заказ КАК Заказ
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_5.Продукция КАК Продукция
	|ГДЕ
	|	Продукция.Заказ <> НЕОПРЕДЕЛЕНО";

Текст.ДобавитьСтроку("=== Примеры связи ЗНП -> документ-основание (ТЧ Продукция.Заказ) ===");
Попытка
	ВыборкаСвязи = ЗапросСвязи.Выполнить().Выбрать();
	Пока ВыборкаСвязи.Следующий() Цикл
		Текст.ДобавитьСтроку("   " + Строка(ВыборкаСвязи.ЗаказНаПроизводство)
			+ " | " + Строка(ВыборкаСвязи.Статус)
			+ " | " + Строка(ВыборкаСвязи.Заказ));
	КонецЦикла;
Исключение
	Текст.ДобавитьСтроку("   ОШИБКА: " + ОписаниеОшибки());
	Текст.ДобавитьСтроку("   (значит, поле Продукция.Заказ называется иначе — см. список реквизитов выше)");
КонецПопытки;

Текст.Показать("Диагностика метаданных");
