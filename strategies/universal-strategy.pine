//@version=6
// Универсальная стратегия из четырёх компонентов:
//   1. UT Bot Alerts (QuantNomad)        — генератор входов по ATR-трейлинг-стопу
//   2. CCI (Дональд Ламберт)             — фильтр импульса
//   3. Squeeze Momentum [LazyBear]       — фильтр волатильности и направления momentum
//   4. Smart Money Concepts (структура)  — фильтр по BOS/CHoCH: торговля только по структуре рынка
strategy("Universal Strategy: UT Bot + CCI + SQZMOM + SMC", overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05)

// ───────── UT Bot ─────────
utKey       = input.float(1.0,  "Key Value (чувствительность)", minval = 0.1, step = 0.1, group = "UT Bot")
utAtrPeriod = input.int(10,     "ATR Period",                   minval = 1,               group = "UT Bot")
useHeikin   = input.bool(false, "Сигналы по Heikin Ashi",                                 group = "UT Bot")
paintBars   = input.bool(false, "Красить бары по позиции UT Bot",                         group = "UT Bot")

src   = useHeikin ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close
atrVal = ta.atr(utAtrPeriod)
nLoss  = utKey * atrVal

var float utStop = na
utStop := src > nz(utStop[1]) and src[1] > nz(utStop[1]) ? math.max(nz(utStop[1]), src - nLoss) :
     src < nz(utStop[1]) and src[1] < nz(utStop[1]) ? math.min(nz(utStop[1]), src + nLoss) :
     src > nz(utStop[1]) ? src - nLoss : src + nLoss

ema1   = ta.ema(src, 1)
utBuy  = src > utStop and ta.crossover(ema1, utStop)
utSell = src < utStop and ta.crossunder(ema1, utStop)

// ───────── CCI-фильтр ─────────
useCci  = input.bool(true, "Включить CCI-фильтр", group = "CCI")
cciLen  = input.int(20,    "CCI Length",          group = "CCI")
cciMode = input.string("Тренд (CCI > 0)", "Режим фильтра",
     options = ["Тренд (CCI > 0)", "Зоны ±100 (не входить в перекупленность)"], group = "CCI")

cci = ta.cci(hlc3, cciLen)
cciLongOk  = not useCci or (cciMode == "Тренд (CCI > 0)" ? cci > 0 : cci < 100)
cciShortOk = not useCci or (cciMode == "Тренд (CCI > 0)" ? cci < 0 : cci > -100)

// ───────── Squeeze Momentum [LazyBear] ─────────
useSqzDir  = input.bool(true,  "Фильтр по направлению momentum",             group = "Squeeze Momentum")
useSqzWait = input.bool(false, "Не входить во время сквиза (ждать выхода)",  group = "Squeeze Momentum")
showSqzBg  = input.bool(true,  "Подсвечивать сквиз фоном",                   group = "Squeeze Momentum")
bbLen      = input.int(20,     "BB Length",                                  group = "Squeeze Momentum")
bbMult     = input.float(2.0,  "BB MultFactor",  step = 0.1,                 group = "Squeeze Momentum")
kcLen      = input.int(20,     "KC Length",                                  group = "Squeeze Momentum")
kcMult     = input.float(1.5,  "KC MultFactor",  step = 0.1,                 group = "Squeeze Momentum")
useTR      = input.bool(true,  "Use TrueRange (KC)",                         group = "Squeeze Momentum")

// В оригинале LazyBear в расчёте BB стояла multKC (опечатка, исправленная автором) — здесь используется bbMult
basis   = ta.sma(close, bbLen)
dev     = bbMult * ta.stdev(close, bbLen)
upperBB = basis + dev
lowerBB = basis - dev
maKC    = ta.sma(close, kcLen)
rng     = useTR ? ta.tr : high - low
rngMa   = ta.sma(rng, kcLen)
upperKC = maKC + rngMa * kcMult
lowerKC = maKC - rngMa * kcMult
sqzOn   = lowerBB > lowerKC and upperBB < upperKC

sqzVal = ta.linreg(close - math.avg(math.avg(ta.highest(high, kcLen), ta.lowest(low, kcLen)), ta.sma(close, kcLen)), kcLen, 0)

sqzLongOk  = (not useSqzDir or sqzVal > 0) and (not useSqzWait or not sqzOn)
sqzShortOk = (not useSqzDir or sqzVal < 0) and (not useSqzWait or not sqzOn)

// ───────── Smart Money Concepts: структура рынка (BOS / CHoCH) ─────────
// Свинги по pivot-точкам; пробой последнего свинг-хая закрытием = бычий слом,
// свинг-лоя = медвежий. BOS — слом по тренду, CHoCH — против (смена характера).
useSmc     = input.bool(true, "Включить SMC-фильтр (структура рынка)", group = "Smart Money Concepts")
smcLen     = input.int(10,    "Период свингов (pivot)", minval = 2,    group = "Smart Money Concepts")
showStruct = input.bool(true, "Показывать метки BOS/CHoCH",            group = "Smart Money Concepts")

ph = ta.pivothigh(high, smcLen, smcLen)
pl = ta.pivotlow(low, smcLen, smcLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   structDir     = 0   // 1 — бычья структура, -1 — медвежья, 0 — не определена
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

breakUp = not na(lastSwingHigh) and close > lastSwingHigh
breakDn = not na(lastSwingLow)  and close < lastSwingLow

if breakUp
    if showStruct
        label.new(bar_index, lastSwingHigh, structDir == -1 ? "CHoCH" : "BOS",
             style = label.style_label_down, color = color.new(color.teal, 20), textcolor = color.white, size = size.small)
    structDir := 1
    lastSwingHigh := na
if breakDn
    if showStruct
        label.new(bar_index, lastSwingLow, structDir == 1 ? "CHoCH" : "BOS",
             style = label.style_label_up, color = color.new(color.maroon, 20), textcolor = color.white, size = size.small)
    structDir := -1
    lastSwingLow := na

smcLongOk  = not useSmc or structDir >= 0
smcShortOk = not useSmc or structDir <= 0

// ───────── Управление позицией ─────────
enableLong  = input.bool(true,  "Лонги",  group = "Позиции")
enableShort = input.bool(true,  "Шорты",  group = "Позиции")
useSlTp     = input.bool(false, "ATR стоп-лосс / тейк-профит", group = "Позиции")
slMult      = input.float(2.0,  "Стоп-лосс, ATR ×",  minval = 0.1, step = 0.1, group = "Позиции")
tpMult      = input.float(3.0,  "Тейк-профит, ATR ×", minval = 0.1, step = 0.1, group = "Позиции")

longOk  = cciLongOk and sqzLongOk and smcLongOk
shortOk = cciShortOk and sqzShortOk and smcShortOk

longSignal  = utBuy  and longOk
shortSignal = utSell and shortOk

var float entryAtr = na
if longSignal and enableLong
    entryAtr := atrVal
    strategy.entry("Long", strategy.long)
if shortSignal and enableShort
    entryAtr := atrVal
    strategy.entry("Short", strategy.short)

// Противоположный сигнал UT Bot всегда закрывает позицию (даже если фильтры не пустили новый вход)
if utSell and strategy.position_size > 0
    strategy.close("Long", comment = "UT exit")
if utBuy and strategy.position_size < 0
    strategy.close("Short", comment = "UT exit")

if useSlTp and strategy.position_size > 0
    strategy.exit("XL", "Long",  stop = strategy.position_avg_price - slMult * entryAtr, limit = strategy.position_avg_price + tpMult * entryAtr)
if useSlTp and strategy.position_size < 0
    strategy.exit("XS", "Short", stop = strategy.position_avg_price + slMult * entryAtr, limit = strategy.position_avg_price - tpMult * entryAtr)

// ───────── Визуализация и алерты ─────────
plot(utStop, "ATR Trailing Stop", color = src > utStop ? color.green : color.red, linewidth = 2)
plotshape(longSignal,  "Buy",  style = shape.labelup,   location = location.belowbar, color = color.green, text = "Buy",  textcolor = color.white, size = size.tiny)
plotshape(shortSignal, "Sell", style = shape.labeldown, location = location.abovebar, color = color.red,   text = "Sell", textcolor = color.white, size = size.tiny)
plotshape(utBuy and not longOk,   "Buy отфильтрован",  style = shape.xcross, location = location.belowbar, color = color.gray, size = size.tiny)
plotshape(utSell and not shortOk, "Sell отфильтрован", style = shape.xcross, location = location.abovebar, color = color.gray, size = size.tiny)

bgcolor(showSqzBg and sqzOn ? color.new(color.orange, 85) : na, title = "Сквиз (низкая волатильность)")
barcolor(paintBars ? (src > utStop ? color.green : color.red) : na)

alertcondition(longSignal,  "Strategy Long",  "Universal Strategy: сигнал LONG")
alertcondition(shortSignal, "Strategy Short", "Universal Strategy: сигнал SHORT")
